<template>
  <main class="dxo-lite-page">
    <header class="dxo-home__header">
      <a class="dxo-home__brand" href="/"><strong>DXO</strong></a>
      <nav class="dxo-home__nav">
        <a href="/">Home</a>
        <a href="/playground">Playground</a>
      </nav>
    </header>

    <h1>@dxo/lite test surface</h1>
    <p>
      Async runtime facade; host f32 until Titan wgpu WASM is linked. TS never retains GPUDevice. WebGL is not a tensor backend.
    </p>

    <section class="dxo-home__card">
      <h2>Probe results</h2>
      <dl>
        <div><dt>version()</dt><dd>{liteVersion}</dd></div>
        <div><dt>capabilities.backend</dt><dd>{liteBackend}</dd></div>
        <div><dt>wasm</dt><dd>{liteWasm}</dd></div>
        <div><dt>webgpu</dt><dd>{liteWebgpu}</dd></div>
        <div><dt>titanWgpuReady</dt><dd>{liteTitanReady}</dd></div>
        <div><dt>webglTensorBackend</dt><dd>{liteWebgl}</dd></div>
        <div><dt>Tensor</dt><dd>{liteTensorClass}</dd></div>
        <div><dt>matmul identity</dt><dd>{liteMatmul}</dd></div>
      </dl>
    </section>

    <section class="dxo-home__card">
      <h2>Node self-test</h2>
      <p>Run <code>pnpm test:lite</code> in <code>projects/homepage</code> or <code>pnpm verify -- lite-webgpu-smoke</code>.</p>
    </section>
  </main>
</template>

<script client>
import { probeLite } from '../lib/lite-probe.ts';

export default class LiteTestPage {
    liteVersion = '';
    liteBackend = '';
    liteWasm = '';
    liteWebgpu = '';
    liteTitanReady = '';
    liteWebgl = '';
    liteTensorClass = '';
    liteMatmul = '';

    async onMount() {
        const probe = await probeLite();
        this.liteVersion = probe.version;
        this.liteBackend = probe.backend;
        this.liteWasm = probe.wasmVersion;
        this.liteWebgpu = String(probe.webgpu);
        this.liteTitanReady = String(probe.titanWgpuReady);
        this.liteWebgl = String(probe.webglTensorBackend);
        this.liteTensorClass = probe.tensorClass;
        this.liteMatmul = probe.matmulOk ? 'ok' : 'fail';
    }
}
</script>
